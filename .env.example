# MySQL connection — fill in each piece separately; DATABASE_URL below is
# assembled from them automatically (Prisma expands ${VAR} in .env files).
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="user"
DB_PASSWORD="password"
DB_NAME="sparkr_sms"
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Twilio (SMS sending). Leave unset in dev if you just want to work on
# everything except actually sending a text — /api/sms/send returns a clear
# 503 instead of pretending to send.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# A Twilio phone number (E.164, e.g. +15551234567) or Messaging Service SID.
TWILIO_FROM_NUMBER=""
